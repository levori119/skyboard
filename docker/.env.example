# העתק ל-docker/.env ומלא. הקובץ .env **אינו** נכנס לגיט.

# ── המאגר המקומי ──────────────────────────────────────────────────────────────
LOCAL_DB_USER=skyking
LOCAL_DB_PASSWORD=       # חובה. מחרוזת אקראית ארוכה.
LOCAL_DB_NAME=skyking
LOCAL_DB_PORT=5433       # 5433 ולא 5432, כדי לא להתנגש ב-Postgres מקומי קיים

# ── המאגר המרכזי (Neon) ───────────────────────────────────────────────────────
# כתובת האפליקציה. ריק = העמדה עולה תמיד עצמאית מול המקומי.
CENTRAL_DATABASE_URL=

# כתובת **תפקיד הרפליקציה** - קריאה בלבד, נפרד ממשתמש האפליקציה.
# משמש את sync-status.sh ואת CREATE SUBSCRIPTION. אינו נמסר לקונטיינר האפליקציה.
REPLICATION_URL=

# ── האפליקציה ─────────────────────────────────────────────────────────────────
APP_PORT=3001
AUTH_SECRET=             # חובה. 32 תווים ומעלה.
ALLOWED_ORIGINS=
STATION_TOKEN=           # אסימון העמדה לשירות המראה (ARCHITECTURE.md §נתק 4)

# auto = מרכזי אם עונה, אחרת מקומי · local = תמיד מקומי · remote = תמיד מרכזי
DB_MODE=auto
