#!/bin/sh
# SKY-KING pre-push hook
# ----------------------
# בכל דחיפה ל-main (למשל `git push origin feature/i18n-bilingual:main`) מוודא
# שגרסת המערכת עודכנה. אם src/version.ts לא השתנה בקומיטים שנדחפים -
# ההוק מריץ את bump-version, מקמט קומיט גרסה, ועוצר את הדחיפה כדי שתריץ אותה שוב
# (git כבר קיבע את ה-SHA לדחיפה לפני שההוק רץ, ולכן חייבים push שני).
#
# הגרסה והתאריך מוצגים ב**מסך הכניסה** וב**חלון העזרה** בעמדה. ראה CLAUDE.md §גרסת המערכת.
#
# עקיפה חד-פעמית (למשל דחיפת hotfix בלי bump):  SKIP_VERSION_BUMP=1 git push ...

[ -n "$SKIP_VERSION_BUMP" ] && exit 0

ZERO=0000000000000000000000000000000000000000
VERSION_FILE="src/version.ts"
REPO_ROOT=$(git rev-parse --show-toplevel) || exit 0

needs_bump=0

while read -r local_ref local_sha remote_ref remote_sha; do
    # רק דחיפות ל-main מעניינות אותנו
    [ "$remote_ref" = "refs/heads/main" ] || continue
    # מחיקת ref - לא רלוונטי
    [ "$local_sha" = "$ZERO" ] && continue

    base="$remote_sha"
    if [ "$base" = "$ZERO" ]; then
        base=$(git rev-parse --verify --quiet origin/main)
    fi
    if [ -z "$base" ]; then
        # main עדיין לא קיים ב-remote - נופלים להשוואה מול הורה הקומיט הנדחף.
        # בלי זה אין נקודת ייחוס וההוק היה מבמפ בכל דחיפה מחדש (לולאה אינסופית).
        base=$(git rev-parse --verify --quiet "${local_sha}^")
        # קומיט ראשון בהיסטוריה - אין מה להשוות
        [ -z "$base" ] && continue
    fi

    # src/version.ts זהה בין מה שנדחף למה שכבר ב-main => לא בומפ
    if git diff --quiet "$base" "$local_sha" -- "$VERSION_FILE"; then
        needs_bump=1
    fi
done

[ "$needs_bump" -eq 1 ] || exit 0

echo ""
echo "  SKY-KING: הגרסה לא עודכנה בקומיטים שנדחפים ל-main."
echo "  מריץ bump אוטומטי..."
echo ""

node "$REPO_ROOT/scripts/bump-version.mjs" || {
    echo ""
    echo "  ✖ bump-version נכשל. הדחיפה בוטלה."
    exit 1
}

new_ver=$(sed -n "s/.*APP_VERSION = '\([^']*\)'.*/\1/p" "$REPO_ROOT/$VERSION_FILE")

git -C "$REPO_ROOT" add -- "$VERSION_FILE" || exit 1
git -C "$REPO_ROOT" commit -m "chore(version): v$new_ver" -- "$VERSION_FILE" || {
    echo ""
    echo "  ✖ יצירת קומיט הגרסה נכשלה. הדחיפה בוטלה."
    exit 1
}

echo ""
echo "  ✅ נוצר קומיט: chore(version): v$new_ver"
echo "  ⛔ הדחיפה בוטלה בכוונה - הרץ אותה שוב כדי לכלול את קומיט הגרסה:"
echo ""
echo "       git push origin feature/i18n-bilingual:main"
echo ""
exit 1
