{
  "appId": "com.skyking.station",
  "productName": "SKY KING Station",
  "copyright": "SKY KING - לוח שמיים",
  "directories": {
    "output": "release-station"
  },
  "files": [
    "electron-main.cjs",
    "electron-status.html",
    "package.json",
    "!node_modules/**/*",
    "!dist/**/*",
    "!src/**/*",
    "!server/**/*",
    "!mirage/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.utilities"
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "category": "Utility"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SKY KING"
  }
}
